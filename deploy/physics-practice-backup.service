[Unit]
Description=Back up Physics Practice SQLite database
After=physics-practice.service

[Service]
Type=oneshot
User=physics-practice
Group=physics-practice
EnvironmentFile=/etc/physics-practice/physics-practice.env
ExecStart=/usr/local/sbin/physics-practice-backup
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/physics-practice
